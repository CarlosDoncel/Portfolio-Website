---
import T from './T.astro';

const items = [
  { n: '01', title: { es: 'Primero el sistema', en: 'System first' }, desc: { es: 'Antes de diseñar una pantalla, entiendo cómo funciona lo que hay detrás. Un buen sistema hace que el diseño sea más simple, no al revés.', en: 'Before designing a screen, I understand how what’s behind it works. A good system makes design simpler, not the other way around.' } },
  { n: '02', title: { es: 'Iterar rápido, pulir después', en: 'Iterate fast, polish later' }, desc: { es: 'Prefiero tener algo jugable o funcional pronto, y luego dedicar el tiempo a los detalles que realmente se notan.', en: 'I prefer having something playable or functional early, then spending time on the details that really matter.' } },
  { n: '03', title: { es: 'El detalle es lo que se recuerda', en: 'The detail is what’s remembered' }, desc: { es: 'La diferencia entre un proyecto correcto y uno memorable está en los detalles de UX/UI, las pruebas y la calidad de cada interacción.', en: 'The difference between a correct project and a memorable one lies in UX/UI details, testing, and the quality of every interaction.' } },
];
---

<section id="filosofia" class="border-y border-line bg-paper-2/70">
  <div class="mx-auto max-w-[1240px] px-[6vw] py-28">
    <div class="mb-14 flex items-baseline gap-4">
      <span class="font-mono text-[13px] text-accent">02</span>
      <h2 class="section-title"><T es="Cómo trabajo" en="How I work" /></h2>
      <span class="h-px flex-1 bg-line"></span>
      <span class="font-mono text-[13px] text-dim"><T es="3 principios" en="3 principles" /></span>
    </div>

    <div class="grid gap-5 md:grid-cols-3">
      {
        items.map((p) => (
          <article class="reveal group relative overflow-hidden border border-line bg-paper p-8 transition-all duration-300 hover:-translate-y-1.5 hover:border-accent/40 hover:shadow-[0_24px_50px_-22px_rgb(139_38_53/0.35)]">
            <span class="pointer-events-none absolute -right-2 -top-6 select-none font-display text-[8rem] font-bold leading-none text-accent/[0.07] transition-colors duration-300 group-hover:text-accent/[0.14]">{p.n}</span>
            <div class="relative">
              <div class="mb-10 h-px w-10 bg-accent transition-all duration-300 group-hover:w-20"></div>
              <h3 class="mb-4 font-display text-2xl font-semibold leading-tight tracking-tight"><T es={p.title.es} en={p.title.en} /></h3>
              <p class="text-[0.97rem] leading-relaxed text-dim"><T es={p.desc.es} en={p.desc.en} /></p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
