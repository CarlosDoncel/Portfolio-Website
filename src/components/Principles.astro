---
import T from './T.astro';

const items = [
  { n: '01', demo: 'flip', title: { es: 'Primero el sistema', en: 'System first' }, desc: { es: 'Antes de diseñar una pantalla, entiendo cómo funciona lo que hay detrás. Un buen sistema hace que el diseño sea más simple, no al revés.', en: 'Before designing a screen, I understand how what’s behind it works. A good system makes design simpler, not the other way around.' } },
  { n: '02', demo: 'iter', title: { es: 'Iterar rápido, pulir después', en: 'Iterate fast, polish later' }, desc: { es: 'Prefiero tener algo jugable o funcional pronto, y luego dedicar el tiempo a los detalles que realmente se notan.', en: 'I prefer having something playable or functional early, then spending time on the details that really matter.' } },
  { n: '03', demo: 'lens', title: { es: 'El detalle es lo que se recuerda', en: 'The detail is what’s remembered' }, desc: { es: 'La diferencia entre un proyecto correcto y uno memorable está en los detalles de UX/UI, las pruebas y la calidad de cada interacción.', en: 'The difference between a correct project and a memorable one lies in UX/UI details, testing, and the quality of every interaction.' } },
];
const bars = [38, 62, 46, 80, 58];
---

<section id="filosofia" class="glow glow-how border-y border-line bg-paper-2/70">
  <div class="mx-auto max-w-[1240px] px-[6vw] py-28">
    <div class="mb-14 flex items-baseline gap-4">
      <span class="font-mono text-[13px] text-accent">02</span>
      <h2 class="section-title"><T es="Cómo trabajo" en="How I work" /></h2>
      <span class="h-px flex-1 bg-line"></span>
      <span class="font-mono text-[13px] text-dim"><T es="3 principios" en="3 principles" /></span>
    </div>

    <div class="grid gap-5 md:grid-cols-3">
      {
        items.map((p) => (
          <article class="reveal group relative overflow-hidden border border-line bg-paper p-8 transition-all duration-300 hover:-translate-y-1.5 hover:border-accent/40 hover:shadow-[0_24px_50px_-22px_rgb(139_38_53/0.35)]">
            <span class="pointer-events-none absolute -right-2 -top-6 select-none font-display text-[8rem] font-bold leading-none text-accent/[0.07] transition-colors duration-300 group-hover:text-accent/[0.14]">{p.n}</span>
            <div class="relative">
              <div class="mb-7 h-px w-10 bg-accent transition-all duration-300 group-hover:w-20"></div>

              {p.demo === 'flip' && (
                <div class="demo demo-flip" data-flipped="false" data-save="idle">
                  <div class="dbar"><i></i><i></i><i></i><span>sistema.ts</span></div>
                  <div class="dbody">
                    <div class="flip-in">
                      <div class="face front">
                        <div class="ui-card">
                          <span class="av"></span>
                          <span class="lines"><i style="width:80%"></i><i style="width:55%"></i></span>
                          <button type="button" class="ui-btn" aria-label="Guardar / Save">
                            <span class="l-idle"><T es="Guardar" en="Save" /></span>
                            <span class="l-busy">···</span>
                            <span class="l-done">✓ <T es="Listo" en="Done" /></span>
                          </button>
                        </div>
                        <span class="front-hint"><T es="Pulsa Guardar" en="Press Save" /></span>
                      </div>
                      <div class="face back">
                        <div class="sys"><b>DB</b><i>→</i><b>API</b><i>→</i><b>UI</b><span class="packet"></span></div>
                        <div class="sys-note"><span class="n-idle">users · auth · save()</span><span class="n-done">save() → 200 OK ✓</span></div>
                      </div>
                    </div>
                    <button type="button" class="demo-btn" aria-pressed="false">
                      <span class="on-front"><T es="Ver por dentro" en="See inside" /> ⟲</span>
                      <span class="on-back"><T es="Ver pantalla" en="See screen" /> ⟲</span>
                    </button>
                  </div>
                </div>
              )}

              {p.demo === 'iter' && (
                <div class="demo demo-iter" style="--p:42">
                  <div class="dbar"><i></i><i></i><i></i><span>iterar.ts</span></div>
                  <div class="dbody">
                    {['rough', 'fine'].map((v) => (
                      <div class={`layer ${v}`} aria-hidden="true">
                        <div class="dash">
                          <div class="d-head"><span class="d-logo"></span><span class="d-nav"></span><span class="d-nav s"></span></div>
                          <div class="d-tiles"><span></span><span></span><span></span></div>
                          <div class="d-chart">{bars.map((h) => <span style={`height:${h}%`}></span>)}</div>
                          <span class="d-btn"></span>
                        </div>
                      </div>
                    ))}
                    <span class="vtag tl">v0.1</span><span class="vtag tr">v1.0</span>
                    <span class="handle" aria-hidden="true"><i>↔</i></span>
                    <span class="hint"><T es="Arrastra" en="Drag" /> ↔</span>
                    <span class="stage" aria-live="polite"></span>
                    <input class="range" type="range" min="0" max="100" value="42" aria-label="Prototipo (v0.1) a versión pulida (v1.0)" />
                  </div>
                </div>
              )}

              {p.demo === 'lens' && (
                <div class="demo demo-lens">
                  <div class="dbar"><i></i><i></i><i></i><span>detalle.css</span></div>
                  <div class="dbody">
                    {['base', 'xray'].map((v) => (
                      <div class={`layer ${v}`} aria-hidden="true">
                        <div class="form">
                          <span class="f-title" data-note="h3 · 600"></span>
                          <span class="f-input" data-note="r 6 · 16px"></span>
                          <div class="f-row">
                            <span class="f-btn" data-note="hover ✓ focus ✓"><T es="Reservar" en="Book" /></span>
                            <span class="f-aa">AA 5.9:1 ✓</span>
                          </div>
                        </div>
                      </div>
                    ))}
                    <span class="ring" aria-hidden="true"></span>
                    <span class="hint"><T es="Mueve el cursor" en="Move the cursor" /></span>
                  </div>
                </div>
              )}

              <h3 class="mb-4 font-display text-2xl font-semibold leading-tight tracking-tight"><T es={p.title.es} en={p.title.en} /></h3>
              <p class="text-[0.97rem] leading-relaxed text-dim"><T es={p.desc.es} en={p.desc.en} /></p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  @property --mx { syntax: '<length-percentage>'; inherits: true; initial-value: 70%; }
  @property --my { syntax: '<length-percentage>'; inherits: true; initial-value: 62%; }
  @keyframes pd-wander {
    0%, 100% { --mx: 24%; --my: 46%; }
    25% { --mx: 76%; --my: 34%; }
    50% { --mx: 68%; --my: 78%; }
    75% { --mx: 30%; --my: 72%; }
  }
  @keyframes pd-packet { 0% { left: 0; opacity: 0; } 12% { opacity: 1; } 88% { opacity: 1; } 100% { left: calc(100% - 8px); opacity: 0; } }
</style>

<style>
  .demo { display: flex; height: 182px; flex-direction: column; margin-bottom: 1.6rem; overflow: hidden; border: 1px solid var(--color-line); background: var(--color-paper-2); font-size: 11px; user-select: none; }
  .dbar { display: flex; height: 22px; flex: none; align-items: center; gap: 5px; padding: 0 9px; border-bottom: 1px solid var(--color-line); background: var(--color-paper); }
  .dbar i { width: 6px; height: 6px; border-radius: 50%; background: rgb(26 26 26 / 0.22); }
  .dbar span { margin-left: 6px; font-family: var(--font-mono); font-size: 9.5px; color: var(--color-dim); }
  .dbody { position: relative; flex: 1; min-height: 0; overflow: hidden; }
  .layer { position: absolute; inset: 0; padding: 12px 14px; }
  .hint { position: absolute; left: 8px; bottom: 6px; z-index: 4; font-family: var(--font-mono); font-size: 9.5px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-dim); transition: opacity 0.4s; pointer-events: none; }
  .demo.touched .hint { opacity: 0; }
  .vtag { position: absolute; top: 6px; z-index: 4; font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.08em; color: var(--color-dim); }
  .vtag.tl { left: 8px; } .vtag.tr { right: 8px; color: var(--color-accent); }

  /* ---- 1 · screen ↔ system ---- */
  .demo-flip .dbody { perspective: 700px; }
  .flip-in { position: absolute; inset: 0; transform-style: preserve-3d; transition: transform 0.65s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .demo-flip[data-flipped='true'] .flip-in { transform: rotateX(180deg); }
  .face { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 10px; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .face.back { transform: rotateX(180deg); background: repeating-linear-gradient(0deg, transparent 0 9px, rgb(139 38 53 / 0.06) 9px 10px); }
  .ui-card { display: flex; align-items: center; gap: 10px; width: min(86%, 270px); padding: 11px 12px; background: var(--color-paper); border: 1px solid var(--color-line); border-radius: 10px; box-shadow: 0 10px 24px -14px rgb(26 26 26 / 0.35); }
  .av { flex: none; width: 26px; height: 26px; border-radius: 50%; background: linear-gradient(135deg, var(--color-accent), #c4586a); }
  .lines { display: flex; flex: 1; flex-direction: column; gap: 5px; }
  .lines i { display: block; height: 6px; border-radius: 3px; background: rgb(26 26 26 / 0.16); }
  .ui-btn { flex: none; min-width: 52px; padding: 5px 9px; border-radius: 6px; background: var(--color-ink); color: var(--color-paper); font-size: 10px; font-weight: 600; cursor: pointer; transition: background 0.2s, transform 0.15s; }
  .ui-btn:hover { background: var(--color-accent); }
  .ui-btn:active { transform: scale(0.95); }
  .ui-btn .l-busy, .ui-btn .l-done { display: none; }
  .demo-flip[data-save='busy'] .ui-btn .l-idle, .demo-flip[data-save='done'] .ui-btn .l-idle { display: none; }
  .demo-flip[data-save='busy'] .ui-btn .l-busy { display: inline; }
  .demo-flip[data-save='done'] .ui-btn .l-done { display: inline; }
  .demo-flip[data-save='done'] .ui-btn { background: #2f7d4f; }
  .front-hint { font-family: var(--font-mono); font-size: 9.5px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-dim); }
  .sys { position: relative; display: flex; align-items: center; gap: 8px; }
  .sys b { padding: 6px 11px; border: 1px solid var(--color-accent); background: var(--color-paper); font-family: var(--font-mono); font-size: 10.5px; font-weight: 500; color: var(--color-accent); }
  .sys i { font-style: normal; color: var(--color-dim); }
  .packet { position: absolute; top: 50%; left: 0; width: 8px; height: 8px; margin-top: -4px; border-radius: 50%; background: var(--color-accent); box-shadow: 0 0 0 4px rgb(139 38 53 / 0.18); animation: pd-packet 1.7s linear infinite; pointer-events: none; }
  .sys-note { font-family: var(--font-mono); font-size: 10px; color: var(--color-dim); }
  .sys-note .n-done, .demo-flip[data-save='done'] .sys-note .n-idle { display: none; }
  .demo-flip[data-save='done'] .sys-note .n-done { display: inline; color: #2f7d4f; }
  .demo-btn { position: absolute; right: 8px; bottom: 8px; z-index: 5; padding: 4px 9px; border: 1px solid var(--color-line); background: var(--color-paper); font-family: var(--font-mono); font-size: 10px; cursor: pointer; transition: background 0.2s, color 0.2s, border-color 0.2s; }
  .demo-btn:hover { background: var(--color-ink); border-color: var(--color-ink); color: var(--color-paper); }
  .demo-btn .on-back, .demo-flip[data-flipped='true'] .demo-btn .on-front { display: none; }
  .demo-flip[data-flipped='true'] .demo-btn .on-back { display: inline; }

  /* ---- 2 · prototype → polished ---- */
  .dash { display: flex; height: 100%; flex-direction: column; gap: 7px; }
  .d-head { display: flex; align-items: center; gap: 6px; }
  .d-logo { width: 16px; height: 16px; } .d-nav { width: 34px; height: 7px; } .d-nav.s { width: 22px; }
  .d-tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; height: 26px; }
  .d-chart { display: flex; flex: 1; align-items: flex-end; gap: 6px; min-height: 0; }
  .d-chart span { flex: 1; }
  .d-btn { width: 62px; height: 17px; }
  .rough { background: var(--color-paper-2); }
  .rough .dash span { border: 1px dashed rgb(26 26 26 / 0.45); background: transparent; }
  .rough .d-chart span { background: repeating-linear-gradient(135deg, transparent 0 4px, rgb(26 26 26 / 0.14) 4px 5px); }
  .fine { background: var(--color-paper); clip-path: inset(0 0 0 calc(var(--p) * 1%)); }
  .fine .d-logo { border-radius: 5px; background: var(--color-accent); }
  .fine .d-nav { border-radius: 4px; background: rgb(26 26 26 / 0.18); }
  .fine .d-tiles span { border-radius: 7px; background: #fff; border: 1px solid var(--color-line); box-shadow: 0 6px 12px -8px rgb(26 26 26 / 0.4); }
  .fine .d-chart span { border-radius: 4px 4px 0 0; background: linear-gradient(180deg, var(--color-accent), #c4586a); }
  .fine .d-btn { border-radius: 999px; background: var(--color-ink); }
  .handle { position: absolute; top: 0; bottom: 0; left: calc(var(--p) * 1%); z-index: 3; width: 2px; margin-left: -1px; background: var(--color-accent); pointer-events: none; }
  .handle i { position: absolute; top: 50%; left: 50%; display: grid; width: 24px; height: 24px; place-items: center; border-radius: 50%; background: var(--color-accent); color: #fff; font-style: normal; font-size: 12px; transform: translate(-50%, -50%); box-shadow: 0 4px 10px rgb(139 38 53 / 0.4); }
  .stage { position: absolute; right: 8px; bottom: 6px; z-index: 4; padding: 2px 7px; border-radius: 999px; background: var(--color-ink); color: var(--color-paper); font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.06em; pointer-events: none; }
  .range { position: absolute; inset: 0; z-index: 6; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; }

  /* ---- 3 · x-ray lens ---- */
  .demo-lens { touch-action: pan-y; cursor: none; }
  .demo-lens:not(.touched) { animation: pd-wander 9s ease-in-out infinite; }
  .demo-lens { --mx: 70%; --my: 62%; }
  .form { display: flex; height: 100%; flex-direction: column; justify-content: center; gap: 11px; padding: 0 6%; }
  .f-title { width: 42%; height: 8px; border-radius: 4px; background: rgb(26 26 26 / 0.7); }
  .f-input { height: 24px; border: 1px solid var(--color-line); border-radius: 6px; background: var(--color-paper); }
  .f-row { display: flex; align-items: center; gap: 10px; }
  .f-btn { display: grid; width: 56%; height: 27px; place-items: center; border-radius: 8px; background: var(--color-accent); color: #fff; font-size: 11px; font-weight: 600; }
  .f-aa { visibility: hidden; font-family: var(--font-mono); font-size: 9px; color: var(--color-accent); white-space: nowrap; }
  .base { background: var(--color-paper-2); }
  .xray { background: rgb(139 38 53 / 0.1); background-image: linear-gradient(rgb(139 38 53 / 0.18) 1px, transparent 1px), linear-gradient(90deg, rgb(139 38 53 / 0.18) 1px, transparent 1px); background-size: 9px 9px; -webkit-mask-image: radial-gradient(circle 58px at var(--mx) var(--my), #000 97%, transparent 100%); mask-image: radial-gradient(circle 58px at var(--mx) var(--my), #000 97%, transparent 100%); }
  .xray .f-aa { visibility: visible; }
  .xray .f-title, .xray .f-input, .xray .f-btn { position: relative; outline: 1px dashed var(--color-accent); outline-offset: 2px; background: rgb(255 255 255 / 0.65); color: var(--color-accent); }
  .xray [data-note]::after { content: attr(data-note); position: absolute; right: 0; top: -13px; padding: 0 3px; background: var(--color-accent); color: #fff; font-family: var(--font-mono); font-size: 8.5px; line-height: 12px; white-space: nowrap; }
  .xray .f-btn::after { top: auto; bottom: -13px; }
  .ring { position: absolute; z-index: 3; left: var(--mx); top: var(--my); width: 116px; height: 116px; border: 1.5px solid var(--color-accent); border-radius: 50%; transform: translate(-50%, -50%); pointer-events: none; box-shadow: 0 0 0 6px rgb(139 38 53 / 0.08); }
  @media (hover: none) { .demo-lens { cursor: auto; } }
  @media (prefers-reduced-motion: reduce) { .flip-in { transition: none; } .packet, .demo-lens:not(.touched) { animation: none; } }
</style>

<script>
  const lang = () => (document.documentElement.lang === 'en' ? 'en' : 'es');
  const seen = (el: Element, fn: () => void) => {
    new IntersectionObserver((es, o) => { if (es[0].isIntersecting) { fn(); o.disconnect(); } }, { threshold: 0.7 }).observe(el);
  };

  // 1 · screen ↔ system (+ a real "save" press)
  document.querySelectorAll<HTMLElement>('.demo-flip').forEach((d) => {
    const flip = d.querySelector<HTMLButtonElement>('.demo-btn')!;
    const save = d.querySelector<HTMLButtonElement>('.ui-btn')!;
    const setFlip = (on: boolean) => { d.dataset.flipped = String(on); flip.setAttribute('aria-pressed', String(on)); };
    let touched = false;
    flip.addEventListener('click', () => { touched = true; setFlip(d.dataset.flipped !== 'true'); });
    let t = 0;
    save.addEventListener('click', () => {
      touched = true;
      clearTimeout(t);
      d.dataset.save = 'busy';
      t = window.setTimeout(() => { d.dataset.save = 'done'; t = window.setTimeout(() => (d.dataset.save = 'idle'), 2600); }, 650);
    });
    // one-time self demo so people notice it is interactive
    seen(d, () => setTimeout(() => {
      if (touched) return;
      setFlip(true);
      setTimeout(() => { if (!touched) setFlip(false); }, 2000);
    }, 500));
  });

  // 2 · slider: prototype → polished
  const labels = { es: ['Funciona', 'Se ve bien', 'Pulido'], en: ['Works', 'Looks good', 'Polished'] };
  document.querySelectorAll<HTMLElement>('.demo-iter').forEach((d) => {
    const r = d.querySelector<HTMLInputElement>('.range')!;
    const stage = d.querySelector<HTMLElement>('.stage')!;
    let raf = 0;
    const setP = (v: number) => {
      d.style.setProperty('--p', String(v));
      const i = v < 34 ? 2 : v < 70 ? 1 : 0; // handle on the right = less polished area
      stage.textContent = `${labels[lang()][i]} ✓`;
    };
    setP(42);
    r.addEventListener('input', () => { cancelAnimationFrame(raf); setP(Number(r.value)); d.classList.add('touched'); });
    document.addEventListener('langchange', () => setP(Number(d.style.getPropertyValue('--p'))));
    // one-time sweep: 42 → 90 → 10 → 42
    seen(d, () => {
      const path = [42, 90, 10, 42]; let seg = 0; let from = 42; const t0 = performance.now(); let segStart = t0;
      const step = (now: number) => {
        if (d.classList.contains('touched')) return;
        const k = Math.min(1, (now - segStart) / 900);
        const e = k < 0.5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2;
        const v = from + (path[seg + 1] - from) * e;
        r.value = String(Math.round(v)); setP(v);
        if (k >= 1) { seg++; from = path[seg]; segStart = now; if (seg >= path.length - 1) return; }
        raf = requestAnimationFrame(step);
      };
      setTimeout(() => (raf = requestAnimationFrame(step)), 400);
    });
  });

  // 3 · lens (wanders on its own until you take over)
  document.querySelectorAll<HTMLElement>('.demo-lens').forEach((d) => {
    const body = d.querySelector<HTMLElement>('.dbody')!;
    const move = (e: PointerEvent) => {
      const b = body.getBoundingClientRect();
      d.style.setProperty('--mx', `${Math.max(0, Math.min(b.width, e.clientX - b.left))}px`);
      d.style.setProperty('--my', `${Math.max(0, Math.min(b.height, e.clientY - b.top))}px`);
      d.classList.add('touched');
    };
    body.addEventListener('pointermove', move);
    body.addEventListener('pointerdown', move);
  });
</script>
