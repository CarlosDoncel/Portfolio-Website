---
import T from './T.astro';
import { projects, groups } from '../data/projects';
---

<section id="trabajo" class="mx-auto max-w-[1240px] px-[6vw] py-28">
  <div class="mb-14 flex items-baseline gap-4">
    <span class="font-mono text-[13px] text-accent">03</span>
    <h2 class="section-title"><T es="Proyectos Destacados" en="Featured Projects" /></h2>
    <span class="h-px flex-1 bg-line"></span>
  </div>

  {
    groups.map((g) => (
      <div class="mt-16 first:mt-0">
        <div class="mb-6 flex flex-wrap items-baseline justify-between gap-4 border-b border-line pb-3.5">
          <span class="font-mono text-[11px] font-medium uppercase tracking-[0.1em] text-accent">
            {g.num} — <T es={g.title.es} en={g.title.en} />
          </span>
          <span class="font-mono text-[10px] uppercase tracking-[0.06em] text-dim">
            <T es={g.note.es} en={g.note.en} />
          </span>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
          {projects
            .filter((p) => p.group === g.key)
            .map((p) => (
              <article class="reveal group">
                <button
                  type="button"
                  data-open={p.key}
                  class="block w-full cursor-pointer text-left"
                  aria-haspopup="dialog"
                >
                  <div class="relative aspect-[16/10] overflow-hidden border border-line bg-paper-2">
                    <img
                      src={p.cover}
                      alt={`${p.title} — portada`}
                      loading="lazy"
                      class="size-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                    />
                    <div class="absolute inset-0 bg-gradient-to-b from-transparent from-35% to-black/75" />
                    <span class="absolute left-4 top-4 bg-paper/90 px-2.5 py-1.5 font-mono text-[10px] uppercase tracking-[0.08em]">
                      {p.index}
                    </span>
                    <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 p-5 text-white">
                      <div>
                        <div class="font-mono text-[10px] uppercase tracking-[0.08em] opacity-80">
                          <T es={p.type.es} en={p.type.en} />
                        </div>
                        <h3 class="mt-1.5 font-display text-[clamp(1.6rem,2.6vw,2.2rem)] font-bold leading-none tracking-tight">
                          {p.title}
                        </h3>
                      </div>
                      <span class="shrink-0 translate-y-2 font-mono text-[10px] uppercase tracking-wider opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100">
                        <T es="Ver proyecto →" en="View project →" />
                      </span>
                    </div>
                  </div>
                </button>

                <div class="pt-4">
                  <div class="font-mono text-[10px] uppercase tracking-[0.06em] text-accent">{p.kicker}</div>
                  <p class="mt-2 max-w-[60ch] text-[0.97rem] text-dim">
                    <T es={p.summary.es} en={p.summary.en} />
                  </p>
                  <div class="mt-4 flex flex-wrap gap-1.5">
                    {p.tags.map((t) => <span class="tag">{t}</span>)}
                  </div>
                </div>
              </article>
            ))}
        </div>
      </div>
    ))
  }
</section>

{
  projects.map((p) => (
    <dialog
      id={`dlg-${p.key}`}
      class="project-dialog fixed inset-0 m-auto h-[94vh] w-[92vw] max-w-[1180px] overflow-y-auto border border-line bg-paper p-0 text-ink backdrop:bg-transparent"
      aria-labelledby={`dlg-title-${p.key}`}
    >
      <button
        type="button"
        data-close
        aria-label="Cerrar / Close"
        class="absolute right-3.5 top-3.5 z-10 grid size-10 place-items-center border border-white/45 bg-ink/75 text-2xl text-white transition-colors hover:bg-accent"
      >×</button>

      <div class="relative h-[min(43vh,450px)] min-h-[245px] overflow-hidden bg-ink">
        <img src={p.cover} alt={`${p.title} — portada`} class="size-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-b from-transparent from-35% to-black/80" />
        <span class="absolute bottom-7 left-[5vw] font-mono text-[11px] text-white">{p.index}</span>
      </div>

      <div class="mx-auto max-w-[1100px] px-[5vw] pb-16 pt-10">
        <div class="flex flex-col gap-5 border-b border-line pb-6 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <span class="font-mono text-[11px] text-accent"><T es={p.category.es} en={p.category.en} /></span>
            <h2 id={`dlg-title-${p.key}`} class="mt-2 font-display text-[clamp(2rem,5vw,4rem)] font-bold leading-none tracking-[-0.045em]">
              {p.title}
            </h2>
          </div>
          <div class="flex flex-wrap gap-2.5">
            <a class="btn btn-solid whitespace-nowrap" href={p.link} target="_blank" rel="noopener">
              <T es={p.linkLabel.es} en={p.linkLabel.en} />
            </a>
            {p.github && (
              <a class="btn btn-outline whitespace-nowrap" href={p.github} target="_blank" rel="noopener">
                <T es="Ver en GitHub ↗" en="View on GitHub ↗" />
              </a>
            )}
          </div>
        </div>

        <div class="grid gap-6 border-b border-line py-7 md:grid-cols-[2fr_1fr] md:gap-10">
          <div>
            <span class="font-mono text-[11px] text-accent"><T es="EL PROYECTO" en="THE PROJECT" /></span>
            <p class="mt-2 text-[1.06rem] leading-[1.65] text-[#4e4a45]"><T es={p.description.es} en={p.description.en} /></p>
          </div>
          <div>
            <span class="font-mono text-[11px] text-accent"><T es="MI ROL" en="MY ROLE" /></span>
            <p class="mt-2 text-[1.06rem] leading-[1.65] text-[#4e4a45]"><T es={p.role.es} en={p.role.en} /></p>
          </div>
        </div>

        <div class="grid grid-cols-2 border-b border-line sm:grid-cols-3 lg:grid-cols-5">
          {p.facts.map((f) => (
            <div class="border-r border-line px-3.5 py-4 last:border-r-0">
              <span class="mb-2 block font-mono text-[10px] uppercase text-accent"><T es={f.label.es} en={f.label.en} /></span>
              <span class="block text-[13px] font-medium leading-snug"><T es={f.value.es} en={f.value.en} /></span>
            </div>
          ))}
        </div>

        <div class="border-b border-line py-8">
          <span class="font-mono text-[11px] text-accent"><T es="01 — EXPERIENCIA" en="01 — EXPERIENCE" /></span>
          <h3 class="mb-4 mt-2 font-display text-[clamp(1.5rem,3vw,2.2rem)] font-semibold leading-tight tracking-tight">
            <T es={p.flowTitle.es} en={p.flowTitle.en} />
          </h3>
          <div class="grid gap-px bg-line md:grid-cols-3">
            {p.flow.map((s, i) => (
              <div class="bg-paper p-[18px] md:min-h-[130px]">
                <b class="mb-4 block font-mono text-[10px] font-medium text-accent">{String(i + 1).padStart(2, '0')}</b>
                <strong class="mb-1.5 block font-display text-[17px] font-semibold"><T es={s.title.es} en={s.title.en} /></strong>
                <span class="block text-[13px] leading-relaxed text-dim"><T es={s.desc.es} en={s.desc.en} /></span>
              </div>
            ))}
          </div>
        </div>

        <div class="border-b border-line py-8">
          <span class="font-mono text-[11px] text-accent"><T es="02 — TECNOLOGÍA & CONTRIBUCIÓN" en="02 — TECHNOLOGY & CONTRIBUTION" /></span>
          <div class="mt-3 grid gap-3 md:grid-cols-2">
            <div class="border-l-2 border-accent bg-paper-2 p-[17px]">
              <strong class="font-display text-sm font-semibold"><T es="Tecnología" en="Technology" /></strong>
              <p class="mt-2 text-[13px] leading-relaxed text-[#5c5751]">{p.stack}</p>
            </div>
            <div class="border-l-2 border-accent bg-paper-2 p-[17px]">
              <strong class="font-display text-sm font-semibold"><T es="Lo que desarrollé" en="What I developed" /></strong>
              <p class="mt-2 text-[13px] leading-relaxed text-[#5c5751]"><T es={p.contribution.es} en={p.contribution.en} /></p>
            </div>
          </div>
        </div>

        <div class="border-b border-line py-8" data-gallery>
          <div class="mb-3 flex justify-between font-mono text-[11px]">
            <span class="text-accent"><T es="03 — GALERÍA" en="03 — GALLERY" /></span>
            <span data-count>01 / {String(p.gallery.length).padStart(2, '0')}</span>
          </div>
          <div class="relative h-[min(46vw,520px)] min-h-[240px] overflow-hidden border border-line bg-paper-2">
            {p.gallery.map((g, i) => (
              <img
                src={g.src}
                alt={g.alt}
                loading="lazy"
                data-slide
                class={`absolute inset-0 size-full object-cover transition-opacity duration-300 ${i === 0 ? 'opacity-100' : 'pointer-events-none opacity-0'}`}
              />
            ))}
            <button type="button" data-prev aria-label="Imagen anterior / Previous image" class="absolute left-3 top-1/2 size-10 -translate-y-1/2 border border-line bg-paper/90 font-mono text-lg transition-colors hover:bg-ink hover:text-paper">←</button>
            <button type="button" data-next aria-label="Siguiente imagen / Next image" class="absolute right-3 top-1/2 size-10 -translate-y-1/2 border border-line bg-paper/90 font-mono text-lg transition-colors hover:bg-ink hover:text-paper">→</button>
          </div>
          <div class="mt-2.5 flex justify-between gap-4 font-mono text-[11px] text-dim">
            <span>
              {p.gallery.map((g, i) => (
                <span data-caption class={i === 0 ? '' : 'hidden'}><T es={g.caption.es} en={g.caption.en} /></span>
              ))}
            </span>
            <span>{p.title}</span>
          </div>
        </div>

        <div class="pt-8">
          <div class="mb-3 font-mono text-[11px] text-accent"><T es="04 — TRAILER" en="04 — TRAILER" /></div>
          <div class="flex min-h-[230px] items-center justify-center overflow-hidden bg-[#111]">
            <video controls playsinline preload="none" class="h-[min(40vw,450px)] w-full object-contain">
              <source src={p.video} type="video/mp4" />
            </video>
          </div>
        </div>
      </div>
    </dialog>
  ))
}

<script>
  const lockScroll = (on: boolean) => (document.body.style.overflow = on ? 'hidden' : '');

  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const dlg = document.getElementById('dlg-' + btn.dataset.open) as HTMLDialogElement | null;
      if (!dlg) return;
      dlg.showModal();
      lockScroll(true);
    }),
  );

  document.querySelectorAll<HTMLDialogElement>('dialog.project-dialog').forEach((dlg) => {
    const close = () => dlg.close();
    dlg.querySelector('[data-close]')?.addEventListener('click', close);
    // click on the backdrop closes
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) close();
    });
    dlg.addEventListener('close', () => {
      lockScroll(false);
      dlg.querySelector('video')?.pause();
    });

    // gallery
    const slides = [...dlg.querySelectorAll<HTMLElement>('[data-slide]')];
    const captions = [...dlg.querySelectorAll<HTMLElement>('[data-caption]')];
    const count = dlg.querySelector<HTMLElement>('[data-count]');
    let i = 0;
    const go = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => {
        s.classList.toggle('opacity-100', k === i);
        s.classList.toggle('opacity-0', k !== i);
        s.classList.toggle('pointer-events-none', k !== i);
      });
      captions.forEach((c, k) => c.classList.toggle('hidden', k !== i));
      if (count) count.textContent = `${String(i + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
    };
    dlg.querySelector('[data-prev]')?.addEventListener('click', () => go(i - 1));
    dlg.querySelector('[data-next]')?.addEventListener('click', () => go(i + 1));
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(i - 1);
      if (e.key === 'ArrowRight') go(i + 1);
    });
  });
</script>
