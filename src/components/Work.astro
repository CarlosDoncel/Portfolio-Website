---
import T from './T.astro';
import { projects, groups } from '../data/projects';
---

<section id="trabajo" class="glow glow-work mx-auto max-w-[1240px] px-[6vw] py-28">
  <div class="mb-14 flex items-baseline gap-4">
    <span class="font-mono text-[13px] text-accent">03</span>
    <h2 class="section-title"><T es="Proyectos Destacados" en="Featured Projects" /></h2>
    <span class="h-px flex-1 bg-line"></span>
    <span class="font-mono text-[13px] text-dim"><T es={`${projects.length} proyectos`} en={`${projects.length} projects`} /></span>
  </div>

  {
    groups.map((g) => (
      <div class="mt-16 first:mt-0">
        <div class="mb-7 flex items-baseline gap-4 border-b border-line pb-3.5">
          <span class="font-mono text-[12px] text-accent">{g.num}</span>
          <h3 class="font-display text-[1.4rem] font-semibold tracking-tight">
            <T es={g.title.es} en={g.title.en} />
          </h3>
          <span class="ml-auto font-mono text-[10px] uppercase tracking-[0.06em] text-dim">
            <T es={g.note.es} en={g.note.en} />
          </span>
        </div>

        <div class="grid gap-x-6 gap-y-10 md:grid-cols-2">
          {projects
            .filter((p) => p.group === g.key)
            .map((p, i) => (
              <article class="reveal" style={`transition-delay:${i * 110}ms`}>
                <a href={`#${p.key}`} data-open={p.key} class="card group block" aria-haspopup="dialog">
                  <div class="relative aspect-[16/10] overflow-hidden border border-line bg-paper-2">
                    <img
                      src={p.cover}
                      alt={`${p.title} — portada`}
                      loading="lazy" decoding="async" width="1920" height="1080"
                      class="size-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                    />
                    <div class="absolute inset-0 bg-gradient-to-b from-transparent from-35% to-black/75" />
                    <span class="absolute left-4 top-4 bg-paper/90 px-2.5 py-1.5 font-mono text-[10px] uppercase tracking-[0.08em]">
                      {p.index}
                    </span>
                    <div class="absolute inset-x-0 bottom-0 p-5 text-white">
                      <div class="font-mono text-[10px] uppercase tracking-[0.08em] opacity-80">
                        <T es={p.type.es} en={p.type.en} />
                      </div>
                      <h3 class="mt-1.5 font-display text-[clamp(1.6rem,2.6vw,2.2rem)] font-bold leading-none tracking-tight">
                        {p.title}
                      </h3>
                    </div>
                  </div>

                  <div class="flex items-start gap-4 pt-4">
                    <div class="min-w-0 flex-1">
                      <div class="font-mono text-[10px] uppercase tracking-[0.06em] text-accent">
                        <T es={p.cardRole.es} en={p.cardRole.en} />
                      </div>
                      <p class="mt-2 line-clamp-3 max-w-[56ch] text-[0.97rem] text-dim">
                        <T es={p.summary.es} en={p.summary.en} />
                      </p>
                      <div class="mt-4 flex flex-wrap gap-1.5">
                        {p.tags.filter((x) => x !== 'QA').slice(0, 4).map((x) => <span class="tag">{x}</span>)}
                      </div>
                    </div>
                    <span class="go" aria-hidden="true">→</span>
                  </div>
                </a>
              </article>
            ))}
        </div>
      </div>
    ))
  }
</section>

<div id="cardPtr" aria-hidden="true"><T es="Ver proyecto" en="View project" /> <span>↗</span></div>

<style>
  #cardPtr {
    position: fixed; left: 0; top: 0; z-index: 60; pointer-events: none;
    padding: 0.55rem 0.95rem; background: var(--color-accent); color: #fff; white-space: nowrap;
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase;
    border-radius: 999px; opacity: 0; scale: 0.6; transform-origin: 0 0;
    transition: opacity 0.2s, scale 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
    box-shadow: 0 6px 20px rgb(139 38 53 / 0.35);
  }
  #cardPtr.on { opacity: 1; scale: 1; }
  @media (pointer: coarse), (prefers-reduced-motion: reduce) { #cardPtr { display: none; } }

  .go { display: grid; flex: none; width: 2.5rem; height: 2.5rem; margin-top: 1.25rem; place-items: center; border: 1px solid var(--color-line); border-radius: 999px; font-family: var(--font-mono); font-size: 0.9rem; transition: background 0.3s, color 0.3s, border-color 0.3s, transform 0.3s; }
  .card:hover .go, .card:focus-visible .go { background: var(--color-ink); border-color: var(--color-ink); color: var(--color-paper); transform: translateX(4px); }

  /* modal */
  .phone { height: min(70vh, 520px); aspect-ratio: 9 / 16; margin-inline: auto; overflow: hidden; border: 7px solid #111; border-radius: 30px; background: #000; box-shadow: 0 30px 50px -28px rgb(0 0 0 / 0.55); }
  .phone video { width: 100%; height: 100%; object-fit: cover; background: #000; }
  .nd { display: grid; flex: none; width: 2rem; height: 2rem; place-items: center; border-radius: 999px; background: var(--color-accent); color: #fff; font: 500 0.75rem var(--font-mono); }
  .sg { flex: 1; height: 2px; margin: 0 0.75rem; background: color-mix(in srgb, var(--color-accent) 35%, transparent); }
  .thumb { opacity: 0.55; cursor: pointer; transition: opacity 0.2s, border-color 0.2s; }
  .thumb:hover { opacity: 0.9; }
  .thumb[data-on] { opacity: 1; border-color: var(--color-accent); box-shadow: 0 0 0 1px var(--color-accent); }
  .lightbox { position: fixed; inset: 0; z-index: 60; display: none; align-items: center; justify-content: center; padding: 1rem; background: rgb(8 8 8 / 0.94); }
  .lightbox.open { display: flex; }
  .lightbox img { max-width: 96vw; max-height: 90vh; object-fit: contain; }
  .lb-btn { position: absolute; display: grid; width: 2.75rem; height: 2.75rem; place-items: center; border: 1px solid rgb(255 255 255 / 0.4); background: rgb(0 0 0 / 0.5); color: #fff; font-family: var(--font-mono); font-size: 1.3rem; cursor: pointer; transition: background 0.2s; }
  .lb-btn:hover { background: var(--color-accent); }
</style>

{
  projects.map((p, idx) => {
    const prev = projects[(idx + projects.length - 1) % projects.length];
    const next = projects[(idx + 1) % projects.length];
    const vertical = p.videoFormat === 'vertical';
    const lab = 'font-mono text-[11px] uppercase tracking-[0.08em] text-accent';
    return (
      <dialog
        id={`dlg-${p.key}`}
        class="project-dialog fixed inset-0 m-auto h-[94vh] w-[92vw] max-w-[1180px] overflow-y-auto border border-line bg-paper p-0 text-ink backdrop:bg-transparent max-sm:h-[100dvh] max-sm:w-screen max-sm:max-w-none"
        aria-labelledby={`dlg-title-${p.key}`}
      >
        <div class="sticky top-0 z-20 h-0">
          <button
            type="button"
            data-close
            aria-label="Cerrar / Close"
            class="absolute right-3.5 top-3.5 grid size-10 place-items-center border border-white/45 bg-ink/75 text-2xl text-white transition-colors hover:bg-accent"
          >×</button>
        </div>

        <div class="relative h-[min(46vh,460px)] min-h-[260px] overflow-hidden bg-ink">
          <img src={p.cover} alt={`${p.title} — portada`} class="size-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/20 to-black/85" />
          <div class="absolute inset-x-0 bottom-0 mx-auto max-w-[1100px] px-[5vw] pb-8 text-white">
            <span class="font-mono text-[11px] tracking-[0.08em] opacity-85"><T es={p.category.es} en={p.category.en} /></span>
            <h2 id={`dlg-title-${p.key}`} class="mt-2 font-display text-[clamp(2.2rem,5.4vw,4.4rem)] font-bold leading-none tracking-[-0.045em]">
              {p.title}
            </h2>
          </div>
        </div>

        <div class="mx-auto max-w-[1100px] px-[5vw] pb-14 pt-10">
          <div class:list={['grid gap-10', vertical && 'lg:grid-cols-[292px_minmax(0,1fr)] lg:gap-16']}>
            {vertical && (
              <aside class="order-last lg:order-none lg:sticky lg:top-6 lg:self-start">
                <div class={`${lab} mb-3 text-center lg:text-left`}><T es="Tráiler" en="Trailer" /></div>
                <div class="phone">
                  <video controls playsinline preload="metadata" poster={p.cover}>
                    <source src={p.video} type="video/mp4" />
                  </video>
                </div>
              </aside>
            )}

            <div class="min-w-0">
              <div class="flex flex-wrap gap-2.5">
                <a class="btn btn-solid whitespace-nowrap" href={p.link} target="_blank" rel="noopener">
                  <T es={p.linkLabel.es} en={p.linkLabel.en} />
                </a>
                {p.github && (
                  <a class="btn btn-outline whitespace-nowrap" href={p.github} target="_blank" rel="noopener">
                    <T es="Ver en GitHub ↗" en="View on GitHub ↗" />
                  </a>
                )}
              </div>

              <div class="mt-9">
                <span class={lab}><T es="El proyecto" en="The project" /></span>
                <p class="mt-2.5 text-[1.1rem] leading-[1.65] text-[#4e4a45]"><T es={p.description.es} en={p.description.en} /></p>
              </div>
              <div class="mt-7">
                <span class={lab}><T es="Mi rol" en="My role" /></span>
                <p class="mt-2.5 text-[1.02rem] leading-[1.65] text-[#4e4a45]"><T es={p.role.es} en={p.role.en} /></p>
              </div>

              <dl class="mt-9 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-line pt-6 sm:grid-cols-3">
                {p.facts.map((f) => (
                  <div>
                    <dt class="mb-1 font-mono text-[10px] uppercase tracking-[0.08em] text-dim"><T es={f.label.es} en={f.label.en} /></dt>
                    <dd class="text-[13.5px] font-medium leading-snug"><T es={f.value.es} en={f.value.en} /></dd>
                  </div>
                ))}
              </dl>

              {!vertical && (
                <div class="mt-12 border-t border-line pt-8">
                  <span class={lab}><T es="Tráiler" en="Trailer" /></span>
                  <div class="mt-3 aspect-video w-full overflow-hidden bg-black">
                    <video controls playsinline preload="metadata" poster={p.cover} class="size-full object-contain">
                      <source src={p.video} type="video/mp4" />
                    </video>
                  </div>
                </div>
              )}

              <div class="mt-12 border-t border-line pt-8">
                <span class={lab}><T es="Experiencia" en="Experience" /></span>
                <h3 class="mt-2 font-display text-[clamp(1.5rem,3vw,2.1rem)] font-semibold leading-tight tracking-tight">
                  <T es={p.flowTitle.es} en={p.flowTitle.en} />
                </h3>
                <ol class="mt-7 grid gap-7 md:grid-cols-3 md:gap-0">
                  {p.flow.map((s, i) => (
                    <li class="md:pr-6">
                      <div class="flex items-center">
                        <span class="nd">{i + 1}</span>
                        {i < p.flow.length - 1 && <span class="sg hidden md:block"></span>}
                      </div>
                      <strong class="mt-4 block font-display text-[1.05rem] font-semibold"><T es={s.title.es} en={s.title.en} /></strong>
                      <span class="mt-1.5 block text-[13.5px] leading-relaxed text-dim"><T es={s.desc.es} en={s.desc.en} /></span>
                    </li>
                  ))}
                </ol>
              </div>

              <div class="mt-12 grid gap-8 border-t border-line pt-8 md:grid-cols-2">
                <div>
                  <span class={lab}><T es="Tecnología" en="Technology" /></span>
                  <p class="mt-3 font-mono text-[12.5px] leading-[1.95] text-[#5c5751]">{p.stack}</p>
                </div>
                <div>
                  <span class={lab}><T es="Lo que desarrollé" en="What I developed" /></span>
                  <p class="mt-3 text-[0.97rem] leading-[1.7] text-[#5c5751]"><T es={p.contribution.es} en={p.contribution.en} /></p>
                </div>
              </div>

              <div class="mt-12 border-t border-line pt-8" data-gallery>
                <div class="mb-3 flex justify-between">
                  <span class={lab}><T es="Galería" en="Gallery" /></span>
                  <span class="font-mono text-[11px] text-dim" data-count>01 / {String(p.gallery.length).padStart(2, '0')}</span>
                </div>
                <div class="relative aspect-video cursor-zoom-in overflow-hidden border border-line bg-paper-2" data-viewer>
                  {p.gallery.map((g, i) => (
                    <img
                      src={g.src}
                      alt={g.alt}
                      loading="lazy" decoding="async" width="1920" height="1080"
                      data-slide
                      class={`absolute inset-0 size-full object-cover transition-opacity duration-300 ${i === 0 ? 'opacity-100' : 'pointer-events-none opacity-0'}`}
                    />
                  ))}
                  <button type="button" data-prev aria-label="Imagen anterior / Previous image" class="absolute left-3 top-1/2 size-10 -translate-y-1/2 border border-line bg-paper/90 font-mono text-lg transition-colors hover:bg-ink hover:text-paper">←</button>
                  <button type="button" data-next aria-label="Siguiente imagen / Next image" class="absolute right-3 top-1/2 size-10 -translate-y-1/2 border border-line bg-paper/90 font-mono text-lg transition-colors hover:bg-ink hover:text-paper">→</button>
                  <span class="pointer-events-none absolute bottom-3 right-3 bg-paper/90 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.08em]"><T es="Ampliar" en="Zoom" /> ⤢</span>
                </div>
                <div class="mt-2.5 grid grid-cols-4 gap-2">
                  {p.gallery.map((g, i) => (
                    <button type="button" data-thumb={i} aria-label={g.alt} class="thumb aspect-video overflow-hidden border border-line" data-on={i === 0 ? '' : undefined}>
                      <img src={g.src} alt="" loading="lazy" decoding="async" width="1920" height="1080" class="size-full object-cover" />
                    </button>
                  ))}
                </div>
                <p class="mt-3 font-mono text-[11px] text-dim">
                  {p.gallery.map((g, i) => (
                    <span data-caption class={i === 0 ? '' : 'hidden'}><T es={g.caption.es} en={g.caption.en} /></span>
                  ))}
                </p>
              </div>

              <nav class="mt-14 grid grid-cols-2 gap-4 border-t border-line pt-6" aria-label="Proyectos / Projects">
                <button type="button" data-goto={prev.key} class="group text-left">
                  <span class="font-mono text-[10px] uppercase tracking-[0.08em] text-dim">← <T es="Anterior" en="Previous" /></span>
                  <span class="mt-1 block font-display text-[1.1rem] font-semibold tracking-tight transition-colors group-hover:text-accent">{prev.title}</span>
                </button>
                <button type="button" data-goto={next.key} class="group text-right">
                  <span class="font-mono text-[10px] uppercase tracking-[0.08em] text-dim"><T es="Siguiente" en="Next" /> →</span>
                  <span class="mt-1 block font-display text-[1.1rem] font-semibold tracking-tight transition-colors group-hover:text-accent">{next.title}</span>
                </button>
              </nav>
            </div>
          </div>
        </div>

        <div class="lightbox" data-lightbox role="dialog" aria-label="Imagen ampliada / Enlarged image">
          <img data-lb-img alt="" />
          <button type="button" data-lb-close aria-label="Cerrar imagen / Close image" class="lb-btn right-4 top-4">×</button>
          <button type="button" data-lb-prev aria-label="Imagen anterior / Previous image" class="lb-btn left-4 top-1/2 -translate-y-1/2">←</button>
          <button type="button" data-lb-next aria-label="Siguiente imagen / Next image" class="lb-btn right-4 top-1/2 -translate-y-1/2">→</button>
        </div>
      </dialog>
    );
  })
}

<script>
  // "Ver proyecto" label that trails the mouse over the project cards (fine pointers only)
  (() => {
    const ptr = document.getElementById('cardPtr');
    if (!ptr || !matchMedia('(pointer: fine)').matches || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let tx = 0, ty = 0, x = 0, y = 0, raf = 0, shown = false;
    const loop = () => {
      x += (tx - x) * 0.2; y += (ty - y) * 0.2;
      ptr.style.translate = `${x + 16}px ${y + 18}px`;
      raf = shown || Math.abs(tx - x) > 0.3 ? requestAnimationFrame(loop) : 0;
    };
    const place = (e: PointerEvent) => { tx = e.clientX; ty = e.clientY; };
    document.querySelectorAll<HTMLElement>('#trabajo .card').forEach((c) => {
      c.addEventListener('pointerenter', (e) => {
        place(e); if (!shown) { x = tx; y = ty; }
        shown = true; ptr.classList.add('on'); if (!raf) raf = requestAnimationFrame(loop);
      });
      c.addEventListener('pointermove', place);
      c.addEventListener('pointerleave', () => { shown = false; ptr.classList.remove('on'); });
      c.addEventListener('click', () => { shown = false; ptr.classList.remove('on'); });
    });
  })();
  const lockScroll = (on: boolean) => (document.body.style.overflow = on ? 'hidden' : '');

  const openProject = (key: string) => {
    const dlg = document.getElementById('dlg-' + key) as HTMLDialogElement | null;
    if (!dlg || dlg.open) return;
    dlg.showModal();
    dlg.scrollTop = 0;
    lockScroll(true);
  };

  document.querySelectorAll<HTMLAnchorElement>('a[data-open]').forEach((card) => {
    card.addEventListener('click', (e) => {
      e.preventDefault();
      const key = card.dataset.open!;
      history.replaceState(null, '', '#' + key);
      openProject(key);
    });
  });

  // deep link: /#flowdesk opens that project
  const fromHash = () => {
    const k = location.hash.slice(1);
    if (k && document.getElementById('dlg-' + k)) openProject(k);
  };
  fromHash();
  window.addEventListener('hashchange', fromHash);

  document.querySelectorAll<HTMLDialogElement>('dialog.project-dialog').forEach((dlg) => {
    const close = () => dlg.close();
    dlg.querySelector('[data-close]')?.addEventListener('click', close);
    // click on the backdrop closes
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) close();
    });
    dlg.addEventListener('close', () => {
      lockScroll(false);
      dlg.querySelectorAll('video').forEach((v) => v.pause());
      lb.classList.remove('open');
      if (location.hash === '#' + dlg.id.replace('dlg-', '')) history.replaceState(null, '', '#trabajo');
    });

    // previous / next project
    dlg.querySelectorAll<HTMLButtonElement>('[data-goto]').forEach((b) =>
      b.addEventListener('click', () => {
        const key = b.dataset.goto!;
        dlg.close();
        openProject(key);
        history.replaceState(null, '', '#' + key);
      }),
    );

    // gallery
    const slides = [...dlg.querySelectorAll<HTMLElement>('[data-slide]')];
    const thumbs = [...dlg.querySelectorAll<HTMLElement>('[data-thumb]')];
    const captions = [...dlg.querySelectorAll<HTMLElement>('[data-caption]')];
    const count = dlg.querySelector<HTMLElement>('[data-count]');
    const lb = dlg.querySelector<HTMLElement>('[data-lightbox]')!;
    const lbImg = lb.querySelector<HTMLImageElement>('[data-lb-img]')!;
    let i = 0;
    const go = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => {
        s.classList.toggle('opacity-100', k === i);
        s.classList.toggle('opacity-0', k !== i);
        s.classList.toggle('pointer-events-none', k !== i);
      });
      thumbs.forEach((t, k) => (k === i ? t.setAttribute('data-on', '') : t.removeAttribute('data-on')));
      captions.forEach((c, k) => c.classList.toggle('hidden', k !== i));
      if (count) count.textContent = `${String(i + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
      if (lb.classList.contains('open')) lbImg.src = (slides[i] as HTMLImageElement).src;
    };
    dlg.querySelector('[data-prev]')?.addEventListener('click', (e) => { e.stopPropagation(); go(i - 1); });
    dlg.querySelector('[data-next]')?.addEventListener('click', (e) => { e.stopPropagation(); go(i + 1); });
    thumbs.forEach((t, k) => t.addEventListener('click', () => go(k)));

    // swipe on the main image
    const viewer = dlg.querySelector<HTMLElement>('[data-viewer]');
    let x0 = 0, moved = false;
    viewer?.addEventListener('pointerdown', (e) => { x0 = e.clientX; moved = false; });
    viewer?.addEventListener('pointerup', (e) => {
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 45) { moved = true; go(i + (dx < 0 ? 1 : -1)); }
    });

    // lightbox
    const openLb = () => { lbImg.src = (slides[i] as HTMLImageElement).src; lb.classList.add('open'); };
    viewer?.addEventListener('click', (e) => {
      if (moved || (e.target as HTMLElement).closest('button')) return;
      openLb();
    });
    lb.querySelector('[data-lb-close]')?.addEventListener('click', () => lb.classList.remove('open'));
    lb.querySelector('[data-lb-prev]')?.addEventListener('click', () => go(i - 1));
    lb.querySelector('[data-lb-next]')?.addEventListener('click', () => go(i + 1));
    lb.addEventListener('click', (e) => { if (e.target === lb) lb.classList.remove('open'); });
    // Escape closes the enlarged image first, not the whole project
    dlg.addEventListener('cancel', (e) => {
      if (lb.classList.contains('open')) { e.preventDefault(); lb.classList.remove('open'); }
    });

    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(i - 1);
      if (e.key === 'ArrowRight') go(i + 1);
    });
  });
</script>
