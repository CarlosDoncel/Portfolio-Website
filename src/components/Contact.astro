---
import T from './T.astro';
const available = [
  { es: 'Software', en: 'Software' }, { es: 'Videojuegos', en: 'Games' }, { es: 'VR/XR', en: 'VR/XR' },
  { es: 'UX/UI', en: 'UX/UI' }, { es: 'Websites', en: 'Websites' }, { es: 'QA / Testing', en: 'QA / Testing' },
];
---

<section id="contacto" class="relative overflow-hidden bg-ink text-paper">
  <div class="pointer-events-none absolute -right-32 -top-32 size-[520px] rounded-full bg-accent/30 blur-[120px]"></div>

  <div class="relative mx-auto max-w-[1240px] px-[6vw] pb-10 pt-28">
    <div class="reveal">
      <div class="mb-6 flex items-center gap-4 font-mono text-[11px] tracking-[0.1em] text-[#d9a0a9]">
        <span>04</span><span class="h-px w-10 bg-[#d9a0a9]/50"></span><T es="CONTÁCTAME" en="CONTACT ME" />
      </div>
      <h2 class="max-w-[16ch] font-display text-[clamp(2.4rem,6vw,5rem)] font-bold uppercase leading-[0.98] tracking-[-0.04em]">
        <T es="¿Tienes una idea? " en="Have an idea? " /><span class="text-[#e08a97]"><T es="Hagámosla real." en="Let’s build it." /></span>
      </h2>
      <p class="mb-10 mt-7 max-w-[600px] text-[1.02rem] leading-relaxed text-paper/65">
        <T
          es="Estoy disponible para desarrollar software, websites y experiencias interactivas, además de UX/UI y QA para mejorar la usabilidad, funcionalidad y calidad de un producto."
          en="I’m available for software, websites, and interactive experiences, as well as UX/UI and QA to improve a product’s usability, functionality, and quality."
        />
      </p>
      <a
        href="mailto:carlosdoncel2004@gmail.com?subject=Proyecto%20-%20Contacto%20desde%20mi%20portfolio"
        class="group inline-flex items-center gap-4 rounded-full bg-paper px-8 py-4 font-display text-base font-semibold text-ink transition-all duration-200 hover:bg-accent hover:text-paper"
        aria-label="Enviar correo a Carlos Daniel Doncel"
      >
        <T es="Hablemos" en="Let’s talk" />
        <span class="transition-transform duration-200 group-hover:translate-x-1.5">→</span>
      </a>
    </div>

    <div class="mt-20 grid border-y border-paper/15 md:grid-cols-[1.2fr_1fr_1fr]">
      <div class="py-6 pr-6">
        <div class="mb-2.5 font-mono text-[10px] uppercase tracking-[0.08em] text-paper/45"><T es="Correo" en="Email" /></div>
        <a class="font-semibold transition-colors hover:text-[#e08a97]" href="mailto:carlosdoncel2004@gmail.com">carlosdoncel2004@gmail.com</a>
      </div>
      <div class="border-t border-paper/15 py-6 md:border-l md:border-t-0 md:pl-6">
        <div class="mb-2.5 font-mono text-[10px] uppercase tracking-[0.08em] text-paper/45">LinkedIn</div>
        <a class="font-semibold transition-colors hover:text-[#e08a97]" href="https://www.linkedin.com/in/carlos-doncel-/" target="_blank" rel="noopener">linkedin.com/in/carlos-doncel-/ ↗</a>
      </div>
      <div class="border-t border-paper/15 py-6 md:border-l md:border-t-0 md:pl-6">
        <div class="mb-2.5 font-mono text-[10px] uppercase tracking-[0.08em] text-paper/45"><T es="Disponible para" en="Available for" /></div>
        <div class="flex flex-wrap gap-1.5">
          {available.map((a) => <span class="rounded-full border border-paper/20 px-2.5 py-1 font-mono text-[10px]"><T es={a.es} en={a.en} /></span>)}
        </div>
      </div>
    </div>

    <footer class="flex flex-wrap justify-between gap-2.5 pt-8 font-mono text-[11px] text-paper/45">
      <span>Carlos Daniel Doncel Cardoso</span>
      <span>Bogotá, Colombia · 2026</span>
    </footer>
  </div>
</section>
